# Frontend Environment Variables
# Copy to .env for local development
# For Vercel, add these in dashboard or via CLI

# Backend API URL
# Local development
VITE_API_URL=http://localhost:5000/api

# Production (update after deploying backend to Render)
# VITE_API_URL=https://cs-roadmap-backend.onrender.com/api

# Optional: Sentry error tracking (leave unset to disable)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

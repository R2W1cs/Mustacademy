# ==============================================
# 🔐 CS ROADMAP PLATFORM - ENVIRONMENT VARIABLES
# ==============================================
# Copy this to .env and fill in your values

# ----------------- DATABASE -----------------
# Get this from Neon console: Dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# ----------------- AUTHENTICATION (httpOnly cookies) -----------------
# Access (15m) and refresh (7d) tokens are issued as httpOnly cookies on login.
# No JWT is returned in response bodies. FRONTEND_URL must match your Vercel origin for CORS/cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ----------------- API CONFIGURATION -----------------
PORT=5000
NODE_ENV=development

# ----------------- FRONTEND URL -----------------
# Local dev
FRONTEND_URL=http://localhost:5173
# Production (update after Vercel deployment)
# FRONTEND_URL=https://your-app.vercel.app

# ----------------- OBJECT STORAGE (Production — Cloudflare R2 or S3) -----------------
# When set, peer videos and TTS assets are stored durably instead of ephemeral disk.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=mustacademy
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxx.r2.dev
# S3_FORCE_PATH_STYLE=false

# ----------------- AI PROVIDERS -----------------
# Required for Dr Nova, Boardroom, Market AI synthesis. Without this you get
# "EMERGENCY PROTOCOL" / offline mock replies. Set on Render (backend), not Vercel.

# OpenRouter (preferred when OPENROUTER_API_KEY is set). Routes: quality | boardroom | fast
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://mustacademy.vercel.app
OPENROUTER_APP_TITLE=MustAcademy
OPENROUTER_MODEL_QUALITY=openai/gpt-4o
OPENROUTER_MODEL_BOARDROOM=openai/gpt-4o
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
# AI_PRIMARY=auto
# Prefer one provider first: auto | openrouter | groq | orca | inception

GROQ_API_KEY=
# Optional overrides (defaults work for current Groq accounts):
# Do NOT set llama-3.3-70b-versatile — Groq retired it (404 model_not_found).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=groq/compound-mini

# Inception Labs Mercury (OpenAI-compatible). Used after Groq fails, or first if AI_PRIMARY=inception.
# INCEPTION_API_KEY=
# INCEPTION_MODEL=mercury-2
# INCEPTION_REASONING_EFFORT=low

# Orca Router (OpenAI-compatible). Free flash models; used in callAI / callFastAI / streamAI.
# ORCAROUTER_API_KEY=
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free

# ----------------- MARKET PULSE -----------------
# Required for POST /api/market/sync (live Google News ingest via SerpAPI). Set on Render.
SERPAPI_KEY=

# ----------------- EMAIL (Optional) -----------------
# If using email features
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

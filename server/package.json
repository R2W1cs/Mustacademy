{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language js",
    "migrate:status": "node-pg-migrate up --dry-run --migrations-dir migrations --migration-file-language js",
    "storage:sync": "node src/scripts/syncMediaToStorage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@gradio/client": "^2.1.0",
    "@sentry/node": "^10.57.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.73.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.1",
    "msedge-tts": "^2.0.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "wavefile": "^11.0.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "axios": "^1.13.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.1"
  }
}
